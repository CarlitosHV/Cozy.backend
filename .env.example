# Configuración del Servidor API
PORT=3000
NODE_ENV=production
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui_2026
CORS_ORIGIN=https://cozy.hardbug.mx,http://localhost:3000

# ===================================================================
# CONEXIÓN A BASES DE DATOS EN DOKPLOY
# ===================================================================

# CASO 1: Conexión interna (Recomendada - Red 'dokploy-network')
# Copia la "Internal URL" o "Host" que te da Dokploy en la pestaña de cada base de datos:
# Ejemplo MongoDB en Dokploy:
MONGODB_URI=mongodb://usuario:password@nombre-del-servicio-mongo:27017/cozyleap?authSource=admin
# Ejemplo Redis en Dokploy:
REDIS_URL=redis://:password@nombre-del-servicio-redis:6379

# CASO 2: Si conectas por los puertos expuestos en el Host/VPS (External Port):
# MONGODB_URI=mongodb://usuario:password@host.docker.internal:27017/cozyleap?authSource=admin
# REDIS_URL=redis://:password@host.docker.internal:6379

# ===================================================================
# IA (xAI / Grok) para las copias del Skinwalker (opcional)
# ===================================================================
# Sin clave, el juego usa sus propias reglas. NUNCA subas la clave real al repositorio.
XAI_API_KEY=
XAI_MODEL=grok-4.7
