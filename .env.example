# Configuración del Servidor API
PORT=3000
NODE_ENV=production
JWT_SECRET=tu_secreto_jwt_super_seguro_aqui_2026
CORS_ORIGIN=https://cozy.hardbug.mx,http://localhost:3000

# ===================================================================
# CADENAS DE CONEXIÓN A TUS CONTENEDORES EXISTENTES
# ===================================================================

# 1. Conexión a tu contenedor de MongoDB:
# Si están en la misma red de Docker (usa el nombre del contenedor de Mongo):
MONGODB_URI=mongodb://usuario:password@nombre_contenedor_mongo:27017/cozyleap?authSource=admin
# O si Mongo está expuesto en el host:
# MONGODB_URI=mongodb://host.docker.internal:27017/cozyleap
# O sin autenticación:
# MONGODB_URI=mongodb://nombre_contenedor_mongo:27017/cozyleap

# 2. Conexión a tu contenedor de Redis:
# Si están en la misma red de Docker (usa el nombre del contenedor de Redis):
REDIS_URL=redis://:password@nombre_contenedor_redis:6379
# O si Redis no tiene contraseña:
# REDIS_URL=redis://nombre_contenedor_redis:6379
# O si Redis está expuesto en el host:
# REDIS_URL=redis://host.docker.internal:6379
